# Mixlumo settings. All are optional; defaults are shown.
# Copy to .env only if you need to change something. Never commit .env.
# There are NO secrets in this app today (no accounts, no cloud, no payments).

# Port of the local web server (Docker Compose: the host port)
PORT=7860

# Address the server listens on. Keep 127.0.0.1 on a PC; the Docker image sets 0.0.0.0.
# AUDIO_STUDIO_HOST=127.0.0.1

# 1 = web deployment (no "Open folder" buttons). Set by the Docker image.
# AUDIO_STUDIO_WEB=

# Where results are saved (default: %USERPROFILE%\Music\Mixlumo)
# AUDIO_STUDIO_OUT=

# Where uploads are kept while the app runs (deleted at each start)
# AUDIO_STUDIO_UPLOADS=

# Where AI model files live (default: %USERPROFILE%\.audiostudio\models; the desktop app uses its bundled copy)
# AUDIO_STUDIO_MODELS=

# Max upload size in MB
AUDIO_STUDIO_MAX_UPLOAD_MB=1024

# Seconds of inactivity before the AI engine exits and frees all GPU memory
AUDIO_STUDIO_IDLE_UNLOAD_S=300

# Demucs model cache (the desktop app uses its bundled copy)
# TORCH_HOME=

# ---------------------------------------------------------------------------
# Feedback e-mail (Help & Feedback page). PRIVATE: put real values only in your own .env
# (git-ignored) or in the server's secret settings, never in this file or in the code.
# Leave empty to keep feedback on this computer only.
# ---------------------------------------------------------------------------
# Who receives new feedback: comma-separated addresses. Never shown on the site.
FEEDBACK_NOTIFY_TO=
# Outgoing mail server. Gmail: smtp.gmail.com, port 465, ssl
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
# Login. For Gmail create an App password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Sender address (defaults to SMTP_USER)
SMTP_FROM=
# Safety cap so nobody can flood the inbox
FEEDBACK_MAX_EMAILS_PER_HOUR=30
# Extra allowed browser origins for the web deployment, e.g. https://app.example.com
AUDIO_STUDIO_ALLOWED_ORIGINS=
